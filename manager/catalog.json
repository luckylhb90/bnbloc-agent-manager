{
  "version": "2026-10-28.1",
  "agents": [
    {
      "id": "claude",
      "name": "Claude Code",
      "installHint": "Claude Code installs with its own installer. Then reopen this page.",
      "latest": {
        "from": "npm",
        "package": "@anthropic-ai/claude-code"
      },
      "detect": {
        "command": "claude",
        "args": [
          "--version"
        ]
      },
      "found": [
        {
          "kind": "vendor-installer",
          "contains": "/.local/share/claude/"
        }
      ],
      "update": [
        {
          "kind": "vendor-installer",
          "args": [
            "update"
          ]
        }
      ],
      "signIn": "Run `claude` once and sign in.",
      "sandbox": {
        "unavailable": "Claude Code signs in with your Claude account, which Anthropic allows only inside Claude Code itself. With an API key it will be offered once the sandbox can hold keys safely; until then use it on this computer."
      }
    },
    {
      "id": "claude-acp",
      "name": "ACP adapter for Claude Code",
      "install": {
        "method": "npm",
        "package": "@agentclientprotocol/claude-agent-acp",
        "bin": "claude-agent-acp",
        "requires": [
          {
            "tool": "node",
            "min": "22",
            "hint": "Install Node.js 22 or newer."
          }
        ]
      },
      "latest": {
        "from": "npm"
      },
      "detect": {
        "command": "claude-agent-acp"
      },
      "register": {
        "name": "claude",
        "profile": {
          "instructionsVia": "meta",
          "skillsDir": ".claude/skills"
        }
      },
      "for": "claude"
    },
