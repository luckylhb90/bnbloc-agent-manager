      },
      "latest": {
        "from": "npm"
      },
      "detect": {
        "command": "codex",
        "args": [
          "--version"
        ]
      },
      "signIn": "Run `codex` once and sign in."
    },
    {
      "id": "codex-acp",
      "name": "ACP adapter for Codex",
      "install": {
        "method": "npm",
        "package": "@agentclientprotocol/codex-acp",
        "bin": "codex-acp"
      },
      "latest": {
        "from": "npm"
      },
      "detect": {
        "command": "codex-acp"
      },
      "register": {
        "name": "codex",
        "profile": {
          "instructionsVia": "file:AGENTS.md",
          "skillsDir": ".agents/skills"
        }
      },
      "for": "codex"
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "install": {
        "method": "npm",
        "package": "@google/gemini-cli",
        "bin": "gemini",
        "requires": [
          {
            "tool": "node",
