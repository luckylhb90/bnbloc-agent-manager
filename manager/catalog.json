    {
      "id": "opencode",
      "name": "OpenCode",
      "install": {
        "method": "npm",
        "package": "opencode-ai",
        "bin": "opencode",
        "ignoreScripts": false
      },
      "latest": {
        "from": "npm"
      },
      "detect": {
        "command": "opencode",
        "args": [
          "--version"
        ]
      },
      "found": [
        {
          "kind": "vendor-installer",
          "contains": "/.opencode/"
        }
      ],
      "update": [
        {
          "kind": "vendor-installer",
          "args": [
            "upgrade"
          ],
          "pinArgs": [
            "upgrade",
            "{version}"
          ]
        }
      ],
      "register": {
        "name": "opencode",
        "args": [
          "acp"
        ],
        "profile": {
          "instructionsVia": "file:AGENTS.md",
          "skillsDir": ".opencode/skills"
        }
      },
      "signIn": "Run `opencode auth login` and sign in.",
      "sandbox": {
        "unavailable": "OpenCode 1.x is not offered in the sandbox. The new generation is its own agent, OpenCode 2."
      }
    },
    {
      "id": "opencode2",
      "name": "OpenCode 2",
