            "hint": "Install Node.js 20 or newer."
          }
        ]
      },
      "latest": {
        "from": "npm"
      },
      "detect": {
        "command": "gemini",
        "args": [
          "--version"
        ]
      },
      "register": {
        "name": "gemini",
        "args": [
          "--acp"
        ]
      },
      "signIn": "Run `gemini` once and sign in."
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "install": {
        "method": "npm",
        "package": "opencode-ai",
        "bin": "opencode",
        "ignoreScripts": false
      },
      "latest": {
        "from": "npm"
      },
      "detect": {
        "command": "opencode",
        "args": [
          "--version"
        ]
      },
      "found": [
        {
          "kind": "vendor-installer",
          "contains": "/.opencode/"
        }
      ],
      "update": [
        {
          "kind": "vendor-installer",
          "args": [
            "upgrade"
          ],
          "pinArgs": [
            "upgrade",
            "{version}"
          ]
        }
      ],
      "register": {
        "name": "opencode",
        "args": [
          "acp"
        ],
        "profile": {
          "instructionsVia": "file:AGENTS.md",
          "skillsDir": ".opencode/skills"
        }
      },
      "signIn": "Run `opencode auth login` and sign in."
    },
