    {
      "id": "omp",
      "name": "omp",
      "installHint": "omp installs with Homebrew: brew install can1357/tap/omp (omp.sh). Then reopen this page.",
      "detect": {
        "command": "omp",
        "args": [
          "--version"
        ]
      },
      "found": [
        {
          "kind": "homebrew",
          "contains": "/cellar/omp/"
        }
      ],
      "update": [
        {
          "kind": "homebrew",
          "command": "brew",
          "args": [
            "upgrade",
            "can1357/tap/omp"
          ]
        }
      ],
      "register": {
        "name": "omp",
        "args": [
          "acp"
        ]
      },
      "signIn": "Run `omp login` and sign in."
    },
    {
      "id": "hermes",
      "name": "Hermes Agent",
      "installHint": "Hermes installs with its own installer. macOS, Linux and WSL2: curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash. Windows (PowerShell): iex (irm https://hermes-agent.nousresearch.com/install.ps1). Then reopen this page.",
      "detect": {
        "command": "hermes",
        "args": [
          "--version"
        ],
        "parse": "v(\\d+\\.\\d+\\.\\d+)"
      },
      "found": [
        {
          "kind": "source",
          "dir": "~/.hermes/hermes-agent"
        },
        {
          "kind": "source",
          "dir": "${LOCALAPPDATA}/hermes/hermes-agent"
        }
      ],
      "update": [
        {
          "kind": "source",
          "args": [
            "update",
            "--no-gateway-restart"
          ]
        }
      ],
      "register": {
        "name": "hermes",
        "args": [
          "acp"
        ]
      },
      "signIn": "Run `hermes setup` and choose a provider."
    }
